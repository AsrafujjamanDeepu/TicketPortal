{
  // Development-only overrides, committed on purpose so a fresh clone runs with zero extra
  // setup (see docs/01-Run-and-Manual-Test-Guide.md). Nothing in this file is
  // a real secret — the signing key below is a fixed, publicly-known placeholder used ONLY
  // when ASPNETCORE_ENVIRONMENT=Development, and Program.cs's fail-fast check explicitly
  // exempts Development from requiring a real one. Never copy this value into a non-Development
  // appsettings file or environment variable.
  "JWT": {
    "SigningKey": "Development-Only-Not-A-Secret-Signing-Key-32Chars+"
  },
  // Chunk 8 / Chunk 6: Hanif's OperatorIntegration.SecretReference is "env:HANIF_ERP_API_KEY" — a
  // POINTER the sync engine resolves at call time (see IntegrationSecretReference), never a
  // literal secret stored in seeded demo data. Since Chunk 6 the pointer may only name an entry
  // under Integrations:Secrets (below) — it can no longer read any other configuration key or
  // process environment variable. This value is deliberately a fixed, publicly-known
  // placeholder, same reasoning as the JWT key above — it only has to match whatever apps/mock-erp
  // checks for (see docs/01-Run-and-Manual-Test-Guide.md), never a real credential. Outside
  // local demos, set the environment variable Integrations__Secrets__HANIF_ERP_API_KEY instead.
  "Integrations": {
    // apps/mock-erp's default port — see docs/01-Run-and-Manual-Test-Guide.md for the local run steps.
    "HanifErpBaseUrl": "http://localhost:5099/api/v1",
    // Chunk 6 / C6-3: Development may call the mock ERP on localhost over plain HTTP. Link-local
    // and cloud-metadata addresses stay blocked even here.
    "AllowLocalDestinations": true,
    "Secrets": {
      "HANIF_ERP_API_KEY": "demo-hanif-erp-key"
    }
  }
}
