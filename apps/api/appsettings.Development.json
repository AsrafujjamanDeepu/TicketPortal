{
  // Development-only overrides, committed on purpose so a fresh clone runs with zero extra
  // setup (see docs/01-Run-and-Manual-Test-Guide.md). Nothing in this file is
  // a real secret — the signing key below is a fixed, publicly-known placeholder used ONLY
  // when ASPNETCORE_ENVIRONMENT=Development, and Program.cs's fail-fast check explicitly
  // exempts Development from requiring a real one. Never copy this value into a non-Development
  // appsettings file or environment variable.
  "JWT": {
    "SigningKey": "Development-Only-Not-A-Secret-Signing-Key-32Chars+"
  },
  // Chunk 8: Hanif's OperatorIntegration.SecretReference is "env:HANIF_ERP_API_KEY" — a
  // POINTER the sync engine resolves at call time (see ExternalBookingSyncService.ResolveSecret),
  // never a literal secret stored in seeded demo data. This value is deliberately a fixed,
  // publicly-known placeholder, same reasoning as the JWT key above — it only has to match
  // whatever apps/mock-erp checks for (see docs/01-Run-and-Manual-Test-Guide.md), never a real credential.
  // Override the HANIF_ERP_API_KEY environment variable for anything beyond local demo use.
  "HANIF_ERP_API_KEY": "demo-hanif-erp-key",
  "Integrations": {
    // apps/mock-erp's default port — see docs/01-Run-and-Manual-Test-Guide.md for the local run steps.
    "HanifErpBaseUrl": "http://localhost:5099/api/v1"
  }
}
